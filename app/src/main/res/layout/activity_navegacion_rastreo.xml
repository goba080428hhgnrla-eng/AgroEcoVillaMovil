<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CENTRAL DE LOGÍSTICA DE REPARTO"
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FASE 1: Recolección en Bodega"
                android:textColor="#FF9800"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnRutaMercado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Navegar al Mercado (Google Maps)"
                android:backgroundTint="#3F51B5"/>
            <Button
                android:id="@+id/btnMarcarRecolectado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ya recogí el producto ✓"
                android:backgroundTint="#4CAF50"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FASE 2: Entrega al Comprador"
                android:textColor="#009688"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnRutaCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Navegar al Destino (Google Maps)"
                android:backgroundTint="#3F51B5"
                android:enabled="false"/>
            <Button
                android:id="@+id/btnMarcarEntregado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pedido Entregado con Éxito 🏁"
                android:backgroundTint="#E91E63"
                android:enabled="false"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
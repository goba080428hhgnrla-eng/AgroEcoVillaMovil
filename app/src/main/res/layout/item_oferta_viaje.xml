<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvDestinoOferta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Destino: Cargando..."
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTotalOferta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Total: $0.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/bar_infe" />

        <Button
            android:id="@+id/btnAceptarOferta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Aceptar Viaje"
            android:backgroundTint="@color/bar_infe"
            android:textColor="@android:color/white" />

    </LinearLayout>

</androidx.cardview.widget.CardView>